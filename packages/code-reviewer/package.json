{
  "name": "@10x/code-reviewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal agent-based code reviewer built on the OpenRouter Agent SDK.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "code-reviewer": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "review": "tsx src/cli.ts",
    "dev": "tsx watch src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "OPENROUTER_RUN_INTEGRATION=1 vitest run",
    "format": "prettier --write .",
    "check": "prettier --check . && npm run typecheck && npm test"
  },
  "dependencies": {
    "@openrouter/agent": "^0.11.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
