---
import Layout from "@/layouts/Layout.astro";
import { angleVerdict } from "@/lib/angle-verdict";
import { formatAngle } from "@/lib/format-angle";
import { createClient } from "@/lib/supabase";
import { effectiveSessionStatus, STALE_PROCESSING_MESSAGE } from "@/lib/session-display-status";
import type { AnalysisResult, FittingSession } from "@/types";

const { id } = Astro.params;

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  return new Response("Service unavailable", { status: 503 });
}

// `.maybeSingle()` so a genuine query failure surfaces as its own `error` instead of
// being indistinguishable from "row absent" (project Risk #7).
const { data: sessionData, error: sessionError } = await supabase
  .from("fitting_sessions")
  .select("id, status, error_message, video_filename, created_at, updated_at")
  .eq("id", id)
  .maybeSingle();

if (sessionError) {
  return new Response(null, { status: 500 });
}
if (!sessionData) {
  return new Response(null, { status: 404 });
}

const session = sessionData as Pick<
  FittingSession,
  "id" | "status" | "error_message" | "video_filename" | "created_at" | "updated_at"
>;

// Display-time-only reconciliation (Risk #6, test-plan §3 Phase 5): a `processing` or
// stuck `queued` session with no progress past `STALE_PROCESSING_MS` renders as a terminal
// "timed out" failure. The stored row is never written back.
const displayStatus = effectiveSessionStatus(session.status, session.updated_at, Date.now());

let results: Pick<AnalysisResult, "recommendations" | "body_angles"> | null = null;
let resultsLoadError = false;

if (session.status === "completed") {
  const { data: resultsData, error: resultsError } = await supabase
    .from("analysis_results")
    .select("recommendations, body_angles")
    .eq("session_id", session.id)
    .maybeSingle();
  // A `completed` session should always have a results row (test-plan §5) — a query
  // error OR a genuinely absent row both route to the same "couldn't load" state
  // rather than the blank card that renders when no branch below matches (Risk #7).
  if (resultsError || !resultsData) {
    resultsLoadError = true;
  } else {
    results = resultsData;
  }
}

const bodyAngles =
  results?.body_angles.map((angle) => ({
    ...angle,
    inRange: angleVerdict(angle.value, angle.reference_min, angle.reference_max),
  })) ?? [];
---

<Layout title="Fitting results">
  <div class="bg-cosmic flex min-h-screen flex-col items-center justify-center p-4">
    <div class="mb-4 w-full max-w-2xl">
      <a href="/dashboard" class="text-sm text-blue-100/70 hover:text-white">&larr; Back to dashboard</a>
    </div>
    <div class="w-full max-w-2xl rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
      {
        session.status === "completed" && results && (
          <div class="flex flex-col gap-8">
            <h1 class="text-2xl font-semibold">Your fitting results</h1>

            <section class="flex flex-col gap-4">
              <h2 class="text-lg font-medium">Recommendations</h2>
              <ul class="flex flex-col gap-4">
                {results.recommendations.map((rec) => (
                  <li class="rounded-xl border border-white/10 bg-white/5 p-4">
                    <p class="font-medium">{rec.adjustment}</p>
                    <p class="text-sm text-blue-100/70">{rec.rationale}</p>
                  </li>
                ))}
              </ul>
            </section>

            <section class="flex flex-col gap-4">
              <h2 class="text-lg font-medium">Body angles</h2>
              <ul class="flex flex-col gap-3">
                {bodyAngles.map((angle) => (
                  <li class="flex items-center justify-between gap-4 rounded-xl border border-white/10 bg-white/5 p-4">
                    <div>
                      <p class="font-medium">{angle.name}</p>
                      <p class="text-sm text-blue-100/70">
                        {formatAngle(angle.value)}&deg; (reference: {formatAngle(angle.reference_min)}&ndash;
                        {formatAngle(angle.reference_max)}&deg;)
                      </p>
                    </div>
                    <span
                      class:list={[
                        "inline-flex shrink-0 items-center rounded-full px-3 py-1 text-sm font-medium",
                        angle.inRange
                          ? "bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300"
                          : "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300",
                      ]}
                    >
                      {angle.inRange ? "In range" : "Outside range"}
                    </span>
                  </li>
                ))}
              </ul>
            </section>
          </div>
        )
      }

      {
        session.status === "completed" && resultsLoadError && (
          <div class="flex flex-col items-center gap-4 p-8 text-center">
            <h1 class="text-xl font-semibold">Couldn't load your results</h1>
            <p class="text-destructive">We couldn't load your results — please refresh.</p>
          </div>
        )
      }

      {
        (displayStatus === "queued" || displayStatus === "processing") && (
          <div class="flex flex-col items-center gap-4 p-8 text-center">
            <h1 class="text-xl font-semibold">Still processing</h1>
            <p class="text-blue-100/70">Your analysis is still processing — check back soon.</p>
          </div>
        )
      }

      {
        displayStatus === "failed" && (
          <div class="flex flex-col items-center gap-4 p-8 text-center">
            <h1 class="text-xl font-semibold">Analysis failed</h1>
            <p class="text-destructive">
              {session.status === "failed" ? session.error_message : STALE_PROCESSING_MESSAGE}
            </p>
          </div>
        )
      }
    </div>
  </div>
</Layout>
